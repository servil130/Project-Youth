    # n "Her shoulders drop, releasing some of the agonizing tension she had been holding."
    n  "Pundaknya perlahan turun, melepaskan sebagian ketegangan menyiksa yang sempat ia tahan sejak tadi."

# game/week2.rpy:184
translate indonesian week2_project_afternoon_2bf9ccbe:

    # n "The heavy classroom door swings open as hurried footsteps rush back in."
    n  "Pintu kelas yang berat berderit terbuka saat suara langkah kaki terburu-buru bergegas masuk kembali."

# game/week2.rpy:186
translate indonesian week2_project_afternoon_ea29a028:

    # n "Trida hurries over, carefully unscrewing a chilled water bottle before handing it to her."
    n  "Trida menghampiri dengan tergesa, hati-hati membuka tutup botol air dingin sebelum menyerahkannya kepada gadis itu."

# game/week2.rpy:187
translate indonesian week2_project_afternoon_c31faea5:

    # trida "Here, drink slowly..."
    trida  "Nih, minum pelan-pelan ya..."

# game/week2.rpy:189
translate indonesian week2_project_afternoon_9131ae96:

    # n "She takes a tentative sip, the coolness helping bring faint color back to her pale cheeks."
    n  "Ia meneguk air itu perlahan, kesegarannya membantu mengembalikan sedikit rona di pipinya yang pucat."

# game/week2.rpy:190
translate indonesian week2_project_afternoon_7b8ae8e2:

    # n "Trida hovers beside the desk, uncharacteristically still and quiet, watching her with deep concern."
    n  "Trida berdiri terpaku di dekat meja, tumben sekali ia diam dan tenang, menatap gadis itu dengan rasa khawatir yang mendalam."

# game/week2.rpy:194
translate indonesian week2_project_afternoon_b04b571a:

    # p "We should probably call it a day now."
    p  "Kayaknya kita mendingan cukupin belajarnya sampai di sini dulu deh."

# game/week2.rpy:196
translate indonesian week2_project_afternoon_f27372ba:

    # p "Let's call it a day. You should get some rest."
    p  "Kita sudahi dulu ya untuk hari ini. Kamu harus banyak istirahat."

# game/week2.rpy:198
translate indonesian week2_project_afternoon_51d119b0:

    # shy_classmate "I'm really sorry for ruining the study session..."
    shy_classmate  "Aku bener-bener minta maaf ya udah ngacauin sesi belajar kelompok kita..."

# game/week2.rpy:199
translate indonesian week2_project_afternoon_5070dcfb:

    # trida "Hey, you don't need to apologise at all."
    trida  "Hei, kamu sama sekali nggak perlu minta maaf lho."

# game/week2.rpy:200
translate indonesian week2_project_afternoon_64c690c5:

    # trida "Your health comes first. Group projects can always wait."
    trida  "Kesehatanmu itu nomor satu. Tugas kelompok mah masih bisa dikerjain kapan-kapan."

# game/week2.rpy:202
translate indonesian week2_project_afternoon_c4ef29eb:

    # n "A faint, grateful smile touches the girl's lips."
    n  "Senyum tipis penuh rasa terima kasih terukir di bibir gadis itu."

# game/week2.rpy:203
translate indonesian week2_project_afternoon_72e918db:

    # n "The three of you pack up her belongings, and together you and Trida walk her down to the lobby until her parents arrive to pick her up."
    n  "Kalian bertiga merapikan barang-barangnya, lalu kamu dan Trida memapahnya bersama-sama turun ke lobi sampai orang tuanya datang menjemput."

# game/week2.rpy:204
translate indonesian week2_project_afternoon_eb858474:

    # shy_classmate "I'll message you both later..."
    shy_classmate  "Nanti aku kabari kalian berdua lewat chat ya..."

# game/week2.rpy:205
translate indonesian week2_project_afternoon_80e04e6a:

    # trida "Take care, okay? Rest up!"
    trida  "Hati-hati di jalan ya! Istirahat yang cukup!"

# game/week2.rpy:220
translate indonesian week2_classroom_sunset_325e92c2:

    # n "The classroom door clicks shut behind you as both of you return to the empty room."
    n  "Pintu kelas berbunyi 'klik' saat kalian berdua melangkah masuk kembali ke dalam ruangan yang kini sudah kosong melompong."

# game/week2.rpy:221
translate indonesian week2_classroom_sunset_175e9556:

    # n "The afternoon sun has dipped lower, casting long, dusty amber rays across the vacant desks."
    n  "Matahari sore kian merendah, membiaskan semburat cahaya jingga keemasan yang panjang di atas deretan meja yang sepi."

# game/week2.rpy:222
translate indonesian week2_classroom_sunset_87efe413:

    # n "The rhythmic ticking of the wall clock seems unusually loud in the quiet room."
    n  "Detak jarum jam dinding terdengar begitu jelas di tengah heningnya ruangan."

# game/week2.rpy:224
translate indonesian week2_classroom_sunset_6cd1283a:

    # n "Trida stands near your shared table, one hand rubbing the back of their neck."
    n  "Trida berdiri di dekat meja belajar kalian, sebelah tangannya mengusap tengkuknya sendiri."

# game/week2.rpy:226
translate indonesian week2_classroom_sunset_9cd92014:

    # trida "I panicked."
    trida  "Tadi aku panik banget."

# game/week2.rpy:228
translate indonesian week2_classroom_sunset_05616534:

    # n "A small, self-deprecating laugh slips from their lips."
    n  "Tawa kecil yang bernada mencela diri sendiri meluncur pelan dari bibirnya."

# game/week2.rpy:229
translate indonesian week2_classroom_sunset_495a0291:

    # n "Their eyes linger on the scattered pens and notebooks on the desk, heavy with guilt and frustration."
    n  "Pandangannya terpaku pada pulpen dan buku catatan yang berserakan di atas meja, sarat akan rasa bersalah dan frustrasi."

# game/week2.rpy:230
translate indonesian week2_classroom_sunset_4893342e:

    # trida "Like, I always mess things up..."
    trida  "Kayak... aku tuh selalu aja ngerusak suasana..."

# game/week2.rpy:242
translate indonesian week2_trida_reassure_noticed_e88a58d1:

    # p "Yeah, I noticed."
    p  "Iya sih, tadi kelihatan banget paniknya."

# game/week2.rpy:243
translate indonesian week2_trida_reassure_noticed_53d018eb:

    # n "A sharp wince crosses Trida's features, followed by a soft, breathy laugh."
    n  "Raut wajah Trida meringis kecil, disusul tawa renyah yang sedikit tertahan."

# game/week2.rpy:245
translate indonesian week2_trida_reassure_noticed_23c2ea15:

    # trida "Wow, okay. No need to confirm it like that!"
    trida  "Wah, tega banget. Nggak usah diiyain juga kali!"

# game/week2.rpy:246
translate indonesian week2_trida_reassure_noticed_0212d447:

    # n "You step closer, placing a comforting hand on their shoulder."
    n  "Kamu melangkah mendekat, menepuk lembut pundaknya untuk menenangkannya."

# game/week2.rpy:247
translate indonesian week2_trida_reassure_noticed_29dbb9ac:

    # p "I know you just wanted to help. That's what counts."
    p  "Aku tahu kok niatmu tadi cuma mau bantuin. Itu yang paling penting."

# game/week2.rpy:253
translate indonesian week2_trida_reassure_fine_8640fc6a:

    # p "Hey, it's fine. Everyone messes up sometimes."
    p  "Hei, santai aja. Semua orang pasti pernah panik atau bikin salah kok."

# game/week2.rpy:254
translate indonesian week2_trida_reassure_fine_8424548e:

    # n "Trida hesitates for a moment, their vibrant orange eyes settling on yours."
    n  "Trida terdiam sejenak, matanya yang beriris oranye senja menatap lurus ke dalam matamu."

# game/week2.rpy:255
translate indonesian week2_trida_reassure_fine_da969dfd:

    # n "It's a penetrating look, stripped of their usual comedic deflection."
    n  "Tatapannya begitu dalam, lepas dari kebiasaannya yang suka melawak untuk menutupi perasaan."

# game/week2.rpy:256
translate indonesian week2_trida_reassure_fine_69e194a9:

    # trida "Guess that includes me, too. Thanks."
    trida  "Kayaknya itu termasuk aku juga ya. Makasih ya."

# game/week2.rpy:258
translate indonesian week2_trida_reassure_fine_a1babb7d:

    # n "Their lips curve into a genuine, warm smile, their voice carrying a quiet relief."
    n  "Bibirnya menyunggingkan senyum hangat yang tulus, nadanya menyiratkan rasa lega yang menenangkan."

# game/week2.rpy:264
translate indonesian week2_trida_reassure_wrong_eeef1fbd:

    # p "You didn't do anything wrong, you know."
    p  "Kamu nggak ngelakuin kesalahan apa pun kok, kamu tahu itu kan."

# game/week2.rpy:265
translate indonesian week2_trida_reassure_wrong_6a1dd206:

    # n "Trida pauses, visibly caught off guard by the certainty in your voice."
    n  "Trida tertegun, tampak terkejut mendengar nada yakin dalam suaramu."

# game/week2.rpy:266
translate indonesian week2_trida_reassure_wrong_2160ad89:

    # n "The words seem to sink deep beneath their defenses."
    n  "Kata-katamu seolah meresap jauh menembus pertahanan dirinya."

# game/week2.rpy:267
translate indonesian week2_trida_reassure_wrong_8602d75e:

    # n "Their shoulders finally slump, a long, slow breath releasing the tight knot in their chest."
    n  "Pundaknya akhirnya mengendur, helaan napas panjang perlahan melepaskan rasa sesak yang menggumpal di dadanya."

# game/week2.rpy:268
translate indonesian week2_trida_reassure_wrong_e973107a:

    # trida "Maybe, but I still wasn't helping much..."
    trida  "Mungkin iya, tapi tadi aku tetep aja nggak banyak ngebantu..."

# game/week2.rpy:270
translate indonesian week2_trida_reassure_wrong_0acc6afe:

    # trida "Still... thanks. Really."
    trida  "Tapi tetep... makasih banyak ya. Beneran deh."

# game/week2.rpy:271
translate indonesian week2_trida_reassure_wrong_13f5ee48:

    # n "Their gaze lingers on yours, an unspoken bond of empathy and understanding tightening between you."
    n  "Tatapannya terpaut pada matamu, ikatan batin dan saling pengertian perlahan terjalin semakin erat di antara kalian."

# game/week2.rpy:276
translate indonesian week2_trida_bond_b075f60a:

    # trida "Thanks for stepping in back there."
    trida  "Makasih ya udah ngambil alih situasi tadi."

# game/week2.rpy:277
translate indonesian week2_trida_bond_87ad427a:

    # n "A soft exhale reverberates in the stillness of the room."
    n  "Helaan napas pelan menggema di tengah heningnya ruangan kelas."

# game/week2.rpy:278
translate indonesian week2_trida_bond_250ce302:

    # trida "You handled that really well."
    trida  "Tadi kamu nanganinnya keren banget."

# game/week2.rpy:280
translate indonesian week2_trida_bond_36ada865:

    # n "You both slowly slide back into your chairs."
    n  "Kalian berdua perlahan duduk kembali di kursi masing-masing."

# game/week2.rpy:281
translate indonesian week2_trida_bond_60a2e0e6:

    # n "Even without looking directly at them, you can feel how easily readable their emotions are."
    n  "Bahkan tanpa menatapnya langsung pun, kamu bisa merasakan betapa mudahnya membaca perasaan sosok di sampingmu ini."

# game/week2.rpy:282
translate indonesian week2_trida_bond_5df756d3:

    # p "Someone had to balance you out."
    p  "Harus ada yang ngimbangin kamu kan."

# game/week2.rpy:284
translate indonesian week2_trida_bond_1ff7626b:

    # trida "Hey! So I'm the chaotic one now?"
    trida  "Heh! Jadi maksudmu sekarang aku ini biang rusuh gitu?"

# game/week2.rpy:285
translate indonesian week2_trida_bond_b93a9c32:

    # n "A fleeting look of exaggerated bewilderment crosses their face, as if processing the accusation."
    n  "Ekspresi bingung yang dilebih-lebihkan tampak di wajahnya, seolah sedang mencerna tuduhan itu."

# game/week2.rpy:287
translate indonesian week2_trida_bond_d77fcb26:

    # trida "Okay, yeah. That's fair."
    trida  "Oke deh, iya. Masuk akal juga sih."

# game/week2.rpy:289
translate indonesian week2_trida_bond_9221eecd:

    # n "Trida's signature cheeky grin breaks through, completely sweeping away the remaining gloom."
    n  "Cengiran jahil khas Trida kembali merekah di bibirnya, seketika menyapu bersih sisa-sisa kesedihan yang tadi sempat menggantung."

# game/week2.rpy:290
translate indonesian week2_trida_bond_c86690a6:

    # p "So, guess it's just us for now..."
    p  "Jadi, tinggal kita berdua dong sekarang..."

# game/week2.rpy:292
translate indonesian week2_trida_bond_fc90b08f:

    # n "Trida clears their throat with an awkward laugh, their fingers drumming against the draft paper."
    n  "Trida berdeham canggung seraya tertawa kecil, jemarinya mengetuk-ngetuk kertas draf tugas."

# game/week2.rpy:294
translate indonesian week2_trida_bond_7b49be03:

    # trida "Anyway—uh, we should probably start over, right?"
    trida  "Ngomong-ngomong—uh, kayaknya kita harus mulai ngerjain lagi dari awal kan?"

# game/week2.rpy:295
translate indonesian week2_trida_bond_e2197e3a:

    # trida "...Partner."
    trida  "...Partner."

# game/week2.rpy:306
translate indonesian week2_partner_moment_7eb91d95:

    # n "A few minutes pass as you both settle into a quiet, comfortable rhythm."
    n  "Beberapa menit berlalu saat kalian berdua mulai menemukan ritme kerja yang tenang dan nyaman."

# game/week2.rpy:307
translate indonesian week2_partner_moment_25f71b2f:

    # n "The soft rustle of paper and the steady scratch of pens replace the earlier noise."
    n  "Gesekan lembut kertas dan goresan pulpen yang teratur menggantikan keriuhan yang sempat terjadi sebelumnya."

# game/week2.rpy:308
translate indonesian week2_partner_moment_63ec4897:

    # trida "Okay, so if we start with this section..."
    trida  "Oke, jadi kalau kita mulai dari bagian ini..."

# game/week2.rpy:310
translate indonesian week2_partner_moment_24d5ba65:

    # n "At the exact same moment, both of your hands reach toward the center of the desk for the correction tape."
    n  "Tepat di detik yang sama, tangan kalian berdua serempak terulur ke tengah meja hendak meraih pita koreksi (tipe-x)."

# game/week2.rpy:311
translate indonesian week2_partner_moment_ab4bed13:

    # n "Your fingers graze against each other—a fleeting brush of skin."
    n  "Jemari kalian tak sengaja saling bersentuhan—sebuah sentuhan kulit yang begitu singkat."

# game/week2.rpy:315
translate indonesian week2_partner_moment_2d22b8fa:

    # n "A sudden spark of surprise courses through your fingertips."
    n  "Sengatan kejut yang tiba-tiba seketika menjalar di ujung-ujung jemarimu."

# game/week2.rpy:316
translate indonesian week2_partner_moment_b9c2bd83:

    # n "For a split second, time seems to freeze in the warm amber glow of the classroom."
    n  "Untuk sepersekian detik, waktu seolah berhenti berputar di bawah pendar hangat cahaya senja di dalam kelas."

# game/week2.rpy:317
translate indonesian week2_partner_moment_c408f1ff:

    # n "The air feels charged, almost electric, momentarily blurring the boundary of simple friendship."
    n  "Udara terasa begitu mendebarkan, seolah memburamkan batas tipis di antara sekadar teman biasa."

# game/week2.rpy:319
translate indonesian week2_partner_moment_104c0465:

    # trida "-Ah, sorry!"
    trida  "-Eh, maaf!"

# game/week2.rpy:321
translate indonesian week2_partner_moment_cab6089a:

    # n "A bright, flustered flush blooms across Trida's cheeks."
    n  "Rona merah padam seketika merebak di kedua pipi Trida karena gugup."

# game/week2.rpy:322
translate indonesian week2_partner_moment_8c6afc95:

    # n "They yank their hand back too quickly, breaking the spell but leaving a lingering warmth between your hands."
    n  "Ia menarik tangannya kembali terlalu cepat, memutus kontak namun meninggalkan rasa hangat yang membekas di antara jemari kalian."

# game/week2.rpy:328
translate indonesian week2_partner_moment_3e71e615:

    # p "It's... fine."
    p  "N-nggak apa-apa kok..."

# game/week2.rpy:329
translate indonesian week2_partner_moment_31d79fce:

    # n "You feel a faint heat creeping onto your own face as you avert your eyes."
    n  "Kamu merasakan rasa hangat yang samar perlahan merambat ke wajahmu sendiri saat kamu mengalihkan pandangan."

# game/week2.rpy:331
translate indonesian week2_partner_moment_992e09c3:

    # p "No problems..."
    p  "Nggak masalah kok..."

# game/week2.rpy:332
translate indonesian week2_partner_moment_b8eae3ed:

    # n "You take a steadying breath, trying to act casual despite your fluttering chest."
    n  "Kamu menarik napas panjang untuk menenangkan diri, berusaha bersikap sewajar mungkin meski dadamu berdebar kencang."

# game/week2.rpy:335
translate indonesian week2_partner_moment_8502274a:

    # p "Oh—yeah. Don't mind it!"
    p  "Oh—iya. Santai aja, jangan dipikirin!"

# game/week2.rpy:336
translate indonesian week2_partner_moment_30ada838:

    # n "You offer a lighthearted laugh, attempting to brush off the undeniable tension."
    n  "Kamu tertawa renyah, berusaha mencairkan ketegangan yang tak bisa dipungkiri itu."

# game/week2.rpy:338
translate indonesian week2_partner_moment_7c7b9b13:

    # n "Neither of you moves for a heartbeat."
    n  "Tak satu pun dari kalian yang bergerak selama beberapa hembusan napas."

# game/week2.rpy:339
translate indonesian week2_partner_moment_2a0dad1d:

    # n "Slowly, you pick up the correction tape and hand it across the desk."
    n  "Perlahan, kamu mengambil pita koreksi itu dan menyodorkannya ke seberang meja."

# game/week2.rpy:340
translate indonesian week2_partner_moment_4ae53edf:

    # n "Trida takes it with a slight tremble in their fingers, their eyes cautiously meeting yours."
    n  "Trida menerimanya dengan jemari yang sedikit bergetar, tatapannya ragu-ragu bertemu dengan tatapanmu."

# game/week2.rpy:341
translate indonesian week2_partner_moment_fc87974a:

    # n "A silent, electric curiosity hangs between you."
    n  "Rasa penasaran yang sarat akan debaran menggantung hening di antara kalian berdua."

# game/week2.rpy:343
translate indonesian week2_partner_moment_e9144066:

    # p "Right. About these paragraphs..."
    p  "Oke. Soal paragraf yang ini tadi..."

# game/week2.rpy:345
translate indonesian week2_partner_moment_7f48811d:

    # n "A soft, radiant smile dances across Trida's lips, warm and bright in the evening light."
    n  "Senyum lembut nan berseri merekah di bibir Trida, tampak begitu hangat dan menawan di bawah temaram cahaya senja."

# game/week2.rpy:346
translate indonesian week2_partner_moment_bed53b2c:

    # trida "...We do make a pretty good team."
    trida  "...Kita ternyata tim yang cocok banget ya."

# game/week2.rpy:348
translate indonesian week2_partner_moment_bd7148b4:

    # n "The quiet dusk wraps around the classroom as you both continue working side by side."
    n  "Keheningan senja perlahan menyelimuti ruang kelas saat kalian berdua kembali melanjutkan pekerjaan berdampingan."

# game/week2.rpy:349
translate indonesian week2_partner_moment_c3799fc2:

    # n "And for the first time, you feel a quiet certainty that this year is going to be unforgettable."
    n  "Dan untuk pertama kalinya, terselip keyakinan hangat di hatimu bahwa tahun ajaran ini bakal jadi masa-masa yang tak terlupakan."

