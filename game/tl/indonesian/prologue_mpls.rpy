# game/prologue_mpls.rpy:23
translate indonesian start_739aba1d:

    # n "The dim light of a study lamp casts a shadow across the desk."
    n  "Cahaya temaram dari lampu belajar membiaskan bayangan di atas meja."

# game/prologue_mpls.rpy:24
translate indonesian start_71ceb7c9:

    # n "The soft, amber glow bathed the room in warmth, creating a cozy cocoon against the creeping chill of the evening outside."
    n  "Pendar hangat kekuningan menyelimuti seisi ruangan, menciptakan rasa nyaman di tengah dinginnya malam yang mulai merayap di luar."

# game/prologue_mpls.rpy:25
translate indonesian start_68d92365:

    # n "Your heart stumbles over when your fingers brush through your open laptop."
    n  "Jantungmu berdegup kencang saat jemarimu menyentuh permukaan laptop yang terbuka."

# game/prologue_mpls.rpy:26
translate indonesian start_2e6df185:

    # n "A frantic beat echoing in your chest as they skim over the cool, sleek surface."
    n  "Detak dada yang berdebar kencang menggema tatkala jemarimu meluncur di atas permukaannya yang sejuk dan mulus."

# game/prologue_mpls.rpy:27
translate indonesian start_d6a1baf1:

    # n "The rhythmic click of the keys punctuated the silence."
    n  "Suara ketukan tuts keyboard yang berirama memecah keheningan malam."

# game/prologue_mpls.rpy:28
translate indonesian start_c7fb7c52:

    # n "As your eyes traced the content on the screen, you allowed yourself to be drawn in deeper."
    n  "Saat matamu menelusuri isi layar, kamu membiarkan dirimu terhanyut semakin dalam."

# game/prologue_mpls.rpy:29
translate indonesian start_68173b60:

    # n "You hovered over the refresh button, your impatience mirrored in the slight tremor of your fingertips."
    n  "Kursormu melayang di atas tombol refresh, rasa tak sabar terpancar dari sedikit getaran di ujung jemarimu."

# game/prologue_mpls.rpy:30
translate indonesian start_eb9ceb32:

    # n "With each click, anticipation hung in the air, almost electric."
    n  "Di setiap klik, rasa antisipasi terasa begitu pekat di udara, begitu mendebarkan."

# game/prologue_mpls.rpy:32
translate indonesian start_f57097f2:

    # n "Just as you were about to refresh the website page once more, a sudden “ding!” jolted you to a halt."
    n  "Tepat ketika kamu hendak menyegarkan laman web itu sekali lagi, sebuah bunyi \"ting!\" tiba-tiba membuatmu terperanjat."

# game/prologue_mpls.rpy:33
translate indonesian start_ed86b1cc:

    # n "It echoed through the quiet room like a signal from another world."
    n  "Suara itu menggema di ruangan yang hening bagaikan sinyal dari dunia lain."

# game/prologue_mpls.rpy:34
translate indonesian start_2a48b32e:

    # p "Oh its from school that i signed up for"
    p  "Oh, ini pesan dari sekolah yang kemarin aku daftarin..."

# game/prologue_mpls.rpy:36
translate indonesian start_2843f3bb:

    # n "You open the phone as you excited..."
    n  "Kamu membuka ponselmu dengan penuh rasa antusias..."

# game/prologue_mpls.rpy:39
translate indonesian start_d14bfd64:

    # n "You scroll through the messages... You heartbeat quickens as you see the phone screen light up."
    n  "Kamu menggulir pesan demi pesan... Jantungmu berdegup semakin kencang saat layar ponsel menyala terang."

# game/prologue_mpls.rpy:41
translate indonesian start_65315e54:

    # n "It say you accepted to join the school, you feel a sense of accomplishment and excitement for the future."
    n  "Tertulis bahwa kamu dinyatakan diterima di sekolah ini. Rasa lega, bangga, dan semangat membuncah membayangkan masa depan."

# game/prologue_mpls.rpy:42
translate indonesian start_cf6b8866:

    # p "Yes! I did it! I got accepted!"
    p  "Yes! Berhasil! Aku beneran diterima!"

# game/prologue_mpls.rpy:50
translate indonesian start_d1986174:

    # n "Two months later…"
    n  "Dua bulan kemudian…"

# game/prologue_mpls.rpy:56
translate indonesian start_3562eb3b:

    # n "The wind blows, causing your hair to move in waves."
    n  "Semilir angin berhembus pelan, membuat helai rambutmu bergerak bergelombang."

# game/prologue_mpls.rpy:57
translate indonesian start_90a1278b:

    # n "Your shoes tap against the ground as you walk with a nervous thrill towards the building of your new school."
    n  "Langkah sepatumu berderap di atas tanah saat kamu melangkah dengan rasa gugup bercampur antusias menuju gedung sekolah barumu."

# game/prologue_mpls.rpy:58
translate indonesian start_134184d9:

    # n "Today marks your first day as an official student at SMK Raden Umar Said."
    n  "Hari ini menandai hari pertamamu resmi menjadi siswa di SMK Raden Umar Said."

# game/prologue_mpls.rpy:63
translate indonesian start_a9239ff8:

    # n "As you walked deeper into the school grounds, the striking red and grey buildings loomed above you, exuding a sense of modernity and excitement."
    n  "Melangkah semakin dalam ke area sekolah, deretan gedung megah berwarna merah dan abu-abu menjulang di depanmu, memancarkan kesan modern dan penuh semangat."

# game/prologue_mpls.rpy:64
translate indonesian start_85a79b7e:

    # n "The air buzzed with energy as students and parents hurried about, chatting and unloading supplies."
    n  "Udara dipenuhi riuh energi para siswa dan orang tua yang berlalu-lalang, mengobrol, dan menurunkan perlengkapan."

# game/prologue_mpls.rpy:65
translate indonesian start_4f76db2b:

    # n "Laughter and footsteps filled the atmosphere, reminding you that you weren't alone."
    n  "Tawa riang dan derap langkah kaki mengisi suasana, mengingatkanmu bahwa kamu tidak sendirian di sini."

# game/prologue_mpls.rpy:66
translate indonesian start_e41b59b6:

    # n "Each person you saw shared the same mix of anxiety and eagerness, all ready to begin their own journey in this new school life."
    n  "Setiap orang yang kamu temui menyiratkan campuran rasa cemas dan antusias yang serupa, siap memulai perjalanan baru mereka di masa sekolah ini."

# game/prologue_mpls.rpy:68
translate indonesian start_3a45b44b:

    # p "This felt like a dream…"
    p  "Semua ini berasa kayak mimpi…"

# game/prologue_mpls.rpy:70
translate indonesian start_b455ac5e:

    # n "You checked the board in front of the lobby, checking for any more information."
    n  "Kamu memeriksa papan pengumuman di depan lobi, mencari informasi lebih lanjut."

# game/prologue_mpls.rpy:71
translate indonesian start_ca577abf:

    # n "More people started to hover around the board; you leaned into the crowd effortfully to read it."
    n  "Semakin banyak orang mulai berkerumun di sekitar papan; kamu berusaha menyusup ke tengah kerumunan untuk membacanya."

# game/prologue_mpls.rpy:72
translate indonesian start_3370c34e:

    # n "Upon further inspection, you could see rows of names divided into groups."
    n  "Setelah diperhatikan lebih dekat, tampak deretan nama yang terbagi ke dalam beberapa kelompok gugus."

# game/prologue_mpls.rpy:73
translate indonesian start_2b5ef72e:

    # n "After a minute of searching, you finally found your name."
    n  "Setelah semenit mencari-cari, akhirnya kamu menemukan namamu sendiri."

# game/prologue_mpls.rpy:76
translate indonesian start_5ad52150:

    # n "[[Group 01: 1. [player_name]]"
    n  "[[Gugus 01: 1. [player_name]]"

# game/prologue_mpls.rpy:78
translate indonesian start_ef4dd041:

    # n "You exhaled deeply, aware of the information weighing on your mind."
    n  "Kamu menghela napas panjang, mencerna informasi penting itu baik-baik di kepala."

# game/prologue_mpls.rpy:79
translate indonesian start_00aa4ebd:

    # n "Determined not to forget your place, you walked deeper into the school buildings."
    n  "Dengan tekad untuk tidak melupakan kelompokmu, kamu melangkah lebih jauh ke area dalam gedung sekolah."

# game/prologue_mpls.rpy:89
translate indonesian inside_MPLS_tent_2449f150:

    # n "Following the instructions, you headed toward the chairs arranged in the school field."
    n  "Mengikuti arahan panitia, kamu bergegas menuju barisan kursi yang tertata rapi di lapangan sekolah."

# game/prologue_mpls.rpy:90
translate indonesian inside_MPLS_tent_2ae56922:

    # n "Amidst the bustling voices announcing the start of the ceremonies, you hurried to find your designated spot."
    n  "Di tengah riuh suara pengumuman bahwa upacara akan segera dimulai, kamu terburu-buru mencari tempat duduk yang telah ditentukan."

# game/prologue_mpls.rpy:91
translate indonesian inside_MPLS_tent_cd3e7f89:

    # n "You take a seat with your group."
    n  "Kamu duduk bersama teman-teman satu gugusmu."

# game/prologue_mpls.rpy:92
translate indonesian inside_MPLS_tent_55e37c76:

    # n "As you finally settle at your desk, a deep sigh of relief escapes your lips."
    n  "Saat akhirnya bisa duduk di bangkumu, helaan napas lega meluncur dari bibirmu."

# game/prologue_mpls.rpy:93
translate indonesian inside_MPLS_tent_e3b22ab2:

    # n "It releases the tension that had been building up since you arrived at the school building."
    n  "Ketegangan yang sempat menumpuk sejak pertama kali tiba di gedung sekolah perlahan menguap."

# game/prologue_mpls.rpy:94
translate indonesian inside_MPLS_tent_9187971d:

    # n "Your shoulders droop slightly as you begin to relax."
    n  "Pundakmu sedikit turun saat tubuhmu mulai merasa lebih rileks."

# game/prologue_mpls.rpy:95
translate indonesian inside_MPLS_tent_3f582130:

    # n "The air around you is filled with a symphony of chatter."
    n  "Udara di sekitarmu dipenuhi simfoni obrolan hangat para siswa baru."

# game/prologue_mpls.rpy:96
translate indonesian inside_MPLS_tent_711a8195:

    # n "The warmth of the crowded tent makes beads of sweat trickle down your back."
    n  "Hawa hangat di dalam tenda yang padat membuat butir-butir keringat perlahan mengalir di punggungmu."

# game/prologue_mpls.rpy:97
translate indonesian inside_MPLS_tent_a26cd9c5:

    # n "With a slow, deliberate glance, you notice someone your age sitting next to you."
    n  "Dengan lirikan perlahan, kamu menyadari ada seseorang seusiamu yang duduk tepat di sebelahmu."

# game/prologue_mpls.rpy:100
translate indonesian inside_MPLS_tent_90878c21:

    # n "Their eyes twinkle with excitement as they dart around the tent, drinking in the vibrant atmosphere."
    n  "Matanya berbinar penuh semangat saat ia memandang berkeliling tenda, menikmati atmosfer yang begitu hidup."

# game/prologue_mpls.rpy:101
translate indonesian inside_MPLS_tent_a637c62a:

    # n "The rich orange of their irises sparkles like the sunset, drawing your attention."
    n  "Kilau jingga terang dari manik matanya berkilau bak senja hari, menarik perhatianmu."

# game/prologue_mpls.rpy:102
translate indonesian inside_MPLS_tent_c9ca7f8c:

    # n "Their brown hair bounces rhythmically as they fidget with enthusiasm."
    n  "Rambut cokelatnya memantul berirama seiring gerak tubuhnya yang tak bisa diam karena antusias."

# game/prologue_mpls.rpy:103
translate indonesian inside_MPLS_tent_d50e1c25:

    # n "An animated presence that contrasts with your stillness."
    n  "Sosoknya yang penuh energi begitu kontras dengan dirimu yang tenang dan diam."

# game/prologue_mpls.rpy:105
translate indonesian inside_MPLS_tent_cd85ac2c:

    # n "Just as you're about to look at them for a second too long, a clear voice breaks through the chatter."
    n  "Tepat saat kamu menatapnya sepersekian detik terlalu lama, suara lantang terdengar memecah keriuhan."

# game/prologue_mpls.rpy:106
translate indonesian inside_MPLS_tent_c82416c8:

    # n "It commands the room's focus."
    n  "Suara itu seketika menarik perhatian seisi ruangan."

# game/prologue_mpls.rpy:108
translate indonesian inside_MPLS_tent_330dfbc7:

    # committee "Good morning, everyone!"
    committee  "Selamat pagi semuanya!"

# game/prologue_mpls.rpy:109
translate indonesian inside_MPLS_tent_a48adf9a:

    # committee "Has everyone taken a breakfast yet?"
    committee  "Udah pada sarapan belum nih?"

# game/prologue_mpls.rpy:110
translate indonesian inside_MPLS_tent_c1b3e66d:

    # committee "It seems like you guys haven't charged up energy yet."
    committee  "Kelihatannya energinya masih pada belum terisi penuh, ya!"

# game/prologue_mpls.rpy:111
translate indonesian inside_MPLS_tent_f12b97c5:

    # n "It's one of the seniors, their tone authoritative yet welcoming, cutting through the noise like a knife through butter."
    n  "Itu salah satu kakak panitia OSIS. Nada bicaranya tegas namun ramah, membelah kebisingan tenda dengan begitu luwes."

# game/prologue_mpls.rpy:112
translate indonesian inside_MPLS_tent_44ce1d64:

    # committee "Oh well then..."
    committee  "Ya sudah kalau begitu..."

# game/prologue_mpls.rpy:113
translate indonesian inside_MPLS_tent_c0172619:

    # committee "Welcome, new students to SMK Raden Umar Said!"
    committee  "Selamat datang, adik-adik siswa baru di SMK Raden Umar Said!"

# game/prologue_mpls.rpy:114
translate indonesian inside_MPLS_tent_eb49f2c2:

    # n "The excited applause fills the space, a chorus of clapping hands that washes over you like a wave, urging you to join in."
    n  "Tepuk tangan meriah langsung membahana memenuhi ruangan, bagai gelombang sorak yang mendorongmu untuk ikut bertepuk tangan."

# game/prologue_mpls.rpy:115
translate indonesian inside_MPLS_tent_41aa1e7a:

    # n "You can't help but feel the pulse of the crowd as you begin to move."
    n  "Kamu tak kuasa menahan debar semangat kerumunan saat suasana mulai bergerak dinamis."

# game/prologue_mpls.rpy:116
translate indonesian inside_MPLS_tent_4c883db5:

    # n "Swept along with your peers as the ceremonies officially commence."
    n  "Hanyut bersama teman-teman seangkatanmu saat upacara pembukaan resmi dimulai."

# game/prologue_mpls.rpy:119
translate indonesian inside_MPLS_tent_a6a1e3b2:

    # n "For the next few hours, the opening ceremonies unfold gracefully."
    n  "Selama beberapa jam berikutnya, rangkaian upacara pembukaan berlangsung dengan lancar dan apik."

# game/prologue_mpls.rpy:120
translate indonesian inside_MPLS_tent_322be59e:

    # n "Each moment designed to immerse the new students in the spirit of the school."
    n  "Setiap sesinya dirancang untuk mengenalkan semangat dan budaya sekolah kepada para siswa baru."

# game/prologue_mpls.rpy:121
translate indonesian inside_MPLS_tent_6342b213:

    # n "Colourful banners flap gently overhead."
    n  "Spanduk warna-warni berkibar pelan di atas kepala."

# game/prologue_mpls.rpy:122
translate indonesian inside_MPLS_tent_3dd5f17e:

    # n "Cheerful presentations from various clubs and societies fill the air with lively chitchat."
    n  "Presentasi ceria dari berbagai klub dan ekstrakurikuler mengisi udara dengan obrolan yang seru."

# game/prologue_mpls.rpy:123
translate indonesian inside_MPLS_tent_2e379efa:

    # n "Yet amidst the lively atmosphere, your mind drifts into introspection, only half-listening as the day rolls on."
    n  "Namun di tengah ramainya suasana, pikiranmu perlahan melayang melamun, hanya mendengarkan setengah hati seiring berjalannya waktu."

# game/prologue_mpls.rpy:125
translate indonesian inside_MPLS_tent_f0dc6f55:

    # committee "It's break time! We repeat, it's break time!"
    committee  "Waktunya istirahat! Sekali lagi, sudah waktunya istirahat!"

# game/prologue_mpls.rpy:126
translate indonesian inside_MPLS_tent_54a40520:

    # committee "If anyone has brought lunch, feel free to enjoy it now."
    committee  "Bagi yang membawa bekal dari rumah, silakan dinikmati sekarang."

# game/prologue_mpls.rpy:127
translate indonesian inside_MPLS_tent_1811e471:

    # committee "But, if you prefer the school canteen, TeddyCup stall, or RB Mart, they are open for food too!"
    committee  "Tapi buat yang mau ke kantin sekolah, stan TeddyCup, atau RB Mart, semuanya juga sudah buka buat kalian!"

# game/prologue_mpls.rpy:129
translate indonesian inside_MPLS_tent_e53daa7c:

    # n "Excitement ripples through the crowd as students spring to their feet."
    n  "Keriuhan kembali pecah saat para siswa serempak beranjak dari tempat duduk mereka."

# game/prologue_mpls.rpy:130
translate indonesian inside_MPLS_tent_525dd09c:

    # n "Eager for a moment of freedom and the chance to explore the tantalising options awaiting them."
    n  "Semua bersemangat menikmati jeda kebebasan dan mencicipi berbagai pilihan jajanan yang menanti."

# game/prologue_mpls.rpy:131
translate indonesian inside_MPLS_tent_63801769:

    # n "You start to feel your stomach rumbling as everyone starts to disperse and take out their lunch boxes."
    n  "Perutmu mulai terasa berkeroncongan saat orang-orang di sekitarmu mulai menyebar dan mengeluarkan kotak bekal mereka."

# game/prologue_mpls.rpy:132
translate indonesian inside_MPLS_tent_bd55beb1:

    # n "Your mind wanders for a moment before you finally decide to..."
    n  "Pikiranmu sempat bimbang sejenak sebelum akhirnya kamu memutuskan untuk..."

# game/prologue_mpls.rpy:147
translate indonesian trida_lunch_b8e06af4:

    # n "You sat there, slowly opening your blue container box with a bunny drawing that you had doodled when you were younger."
    n  "Kamu tetap duduk di situ, perlahan membuka kotak bekal birumu yang berhiaskan stiker kelinci yang kamu gambar waktu kecil."

# game/prologue_mpls.rpy:148
translate indonesian trida_lunch_77dfcb90:

    # n "The smell of the fresh savoury sandwich hits your nose."
    n  "Aroma gurih dan segar dari sandwich buatan rumah langsung menggelitik hidungmu."

# game/prologue_mpls.rpy:149
translate indonesian trida_lunch_69823c0e:

    # n "Before you could pick it up, you could feel eyes glancing towards you."
    n  "Sebelum sempat mengambilnya, kamu merasakan ada sepasang mata yang diam-diam melirik ke arahmu."

# game/prologue_mpls.rpy:151
translate indonesian trida_lunch_7f6f1d28:

    # n "You blinked as you saw that the person earlier looked like they were mesmerised by your food."
    n  "Kamu mengerjap saat melihat sosok yang tadi rupanya sedang menatap makananmu dengan tatapan terpana."

# game/prologue_mpls.rpy:152
translate indonesian trida_lunch_5c800e4f:

    # n "Before then, they noticed and flicked their attention fully towards you."
    n  "Sadar sedang diperhatikan, ia langsung mengalihkan pandangannya sepenuhnya ke arahmu."

# game/prologue_mpls.rpy:164
translate indonesian trida_lunch_nice_534b141b:

    # n "The fellow's eyes shimmered with excitement at the moment you posed your question."
    n  "Matanya seketika berbinar penuh rasa antusias saat kamu melontarkan pertanyaan itu."

# game/prologue_mpls.rpy:165
translate indonesian trida_lunch_nice_e21841ff:

    # n "Their brilliance reminiscent of precious gems glinting in the sunlight, as if they had just unearthed a rare treasure."
    n  "Kilaunya mengingatkanmu pada permata yang berkilau di bawah sinar mentari, seolah baru saja menemukan harta karun berharga."

# game/prologue_mpls.rpy:166
translate indonesian trida_lunch_nice_109fc634:

    # trida "Really?"
    trida  "Beneran nih?!"

# game/prologue_mpls.rpy:167
translate indonesian trida_lunch_nice_b0f2a722:

    # n "You briefly turned your gaze towards them, feeling a flutter of emotions within you at the sudden enthusiasm."
    n  "Kamu melirik sejenak ke arahnya, merasakan desiran hangat melihat antusiasmenya yang begitu spontan."

# game/prologue_mpls.rpy:168
translate indonesian trida_lunch_nice_2b239ea7:

    # n "Then, you shifted your attention to the plate of food in front of you, its colours vibrant and enticing."
    n  "Lalu, kamu menatap kembali kotak bekal di depanmu, warnanya yang cerah tampak begitu menggugah selera."

# game/prologue_mpls.rpy:169
translate indonesian trida_lunch_nice_b39944bf:

    # n "Slowly, almost as if caught in a trance, you nodded your head."
    n  "Perlahan, seolah terhipnotis oleh binar matanya, kamu menganggukkan kepalamu."

# game/prologue_mpls.rpy:170
translate indonesian trida_lunch_nice_28e0088c:

    # n "Your eyes flickered back to them, where you noticed the sparkly light dancing in their eyes."
    n  "Pandanganmu kembali ke arahnya, di mana cahaya ceria tampak berpendar indah di matanya."

# game/prologue_mpls.rpy:171
translate indonesian trida_lunch_nice_e90b4f1b:

    # n "A mixture of curiosity and warmth that made your heart skip a beat."
    n  "Campuran antara rasa penasaran dan kehangatan yang membuat hatimu berdesir pelan."

# game/prologue_mpls.rpy:173
translate indonesian trida_lunch_nice_ac5b895b:

    # trida "Thank you...!"
    trida  "Makasih banyak ya...!"

# game/prologue_mpls.rpy:174
translate indonesian trida_lunch_nice_757cd847:

    # trida "You could also take mine!"
    trida  "Kamu juga boleh kok ambil bekalku!"

# game/prologue_mpls.rpy:175
translate indonesian trida_lunch_nice_a5467f68:

    # n "They smiled, showing you their own lunchbox."
    n  "Ia tersenyum ceria seraya menunjukkan kotak bekal miliknya."

# game/prologue_mpls.rpy:176
translate indonesian trida_lunch_nice_38fcd9ae:

    # n "The delicious-looking fried rice lay nestled among perfectly cooked eggs, making your stomach growl."
    n  "Nasi goreng yang tampak lezat bertabur telur dadar yang matang sempurna membuat perutmu semakin berbunyi."

# game/prologue_mpls.rpy:177
translate indonesian trida_lunch_nice_b703bce8:

    # n "Perhaps you were just hungry, but it was the most appetising fried rice you had ever seen."
    n  "Mungkin karena kamu memang lapar, tapi itu adalah nasi goreng paling menggoda yang pernah kamu lihat."

# game/prologue_mpls.rpy:178
translate indonesian trida_lunch_nice_0ef0da88:

    # p "Oh, thanks! By the way, my name is [player_name]. Nice to meet you."
    p  "Oh, makasih! Ngomong-ngomong, namaku [player_name]. Senang kenal sama kamu."

# game/prologue_mpls.rpy:180
translate indonesian trida_lunch_nice_e70fa434:

    # n "The fellow grinned widely as they slowly moved closer."
    n  "Sosok itu tersenyum lebar seraya menggeser duduknya sedikit lebih dekat."

# game/prologue_mpls.rpy:181
translate indonesian trida_lunch_nice_ddd6afb3:

    # trida "You can call me Trida, [player_name]. Nice to meet you too!"
    trida  "Kamu bisa panggil aku Trida, [player_name]. Salam kenal juga ya!"

# game/prologue_mpls.rpy:184
translate indonesian trida_lunch_nice_92a6dc88:

    # n "That meeting was your first spark in this new school."
    n  "Pertemuan sederhana itu menjadi percikan awal yang manis di sekolah baru ini."

# game/prologue_mpls.rpy:185
translate indonesian trida_lunch_nice_231e6772:

    # n "Both of you continued to chat happily as the first flower of your friendship blossomed."
    n  "Kalian berdua lanjut mengobrol asyik sambil menikmati makan siang, saat benih pertemanan pertama mulai tumbuh bersemi."

# game/prologue_mpls.rpy:194
translate indonesian trida_lunch_bad_414c3560:

    # n "You slowly shifted your gaze away and clutched your lunchbox to yourself."
    n  "Kamu perlahan memalingkan pandangan dan mendekap kotak bekalmu lebih rapat ke tubuhmu."

# game/prologue_mpls.rpy:196
translate indonesian trida_lunch_bad_13ed0d1a:

    # n "The person was startled for a moment, but they then returned to their own lunchbox."
    n  "Orang itu sempat tertegun sejenak, lalu perlahan kembali memfokuskan perhatian pada kotak bekalnya sendiri."

# game/prologue_mpls.rpy:197
translate indonesian trida_lunch_bad_94581d67:

    # n "There is complete silence between the two of you. Perhaps you'll barely interact with the sunset fellow afterwards, if ever."
    n  "Keheningan canggung tercipta di antara kalian berdua. Mungkin setelah ini kamu hampir tidak akan pernah berinteraksi lagi dengannya."

# game/prologue_mpls.rpy:206
translate indonesian radit_teddy_54da0748:

    # n "You stood up from your chair and walked out of the tents."
    n  "Kamu bangkit dari kursi dan melangkah keluar dari tenda."

# game/prologue_mpls.rpy:207
translate indonesian radit_teddy_34eb166e:

    # n "A lot of people are walking around like an army of ants, their stomachs empty."
    n  "Banyak siswa berlalu-lalang seperti barisan semut, sama-sama mencari pengisi perut kosong."

# game/prologue_mpls.rpy:208
translate indonesian radit_teddy_e3c57ba2:

    # n "Before you could hesitate, your foot turned toward one of the food stalls full of new students."
    n  "Tanpa ragu lagi, langkah kakimu berbelok menuju salah satu stan makanan yang ramai dikerumuni siswa baru."

# game/prologue_mpls.rpy:209
translate indonesian radit_teddy_e2944460:

    # n "The big names are put on top of the place: \"Teddy Cups\"."
    n  "Papan nama besar terpampang jelas di atas stan: \"Teddy Cups\"."

# game/prologue_mpls.rpy:210
translate indonesian radit_teddy_aef72411:

    # p "I should try this."
    p  "Kayaknya aku harus coba ini deh."

# game/prologue_mpls.rpy:211
translate indonesian radit_teddy_0bdec140:

    # n "Before you could even try to order, your body stumbled as someone bumped into your shoulders."
    n  "Sebelum sempat memesan, tubuhmu mendadak oleng karena tersenggol bahu seseorang."

# game/prologue_mpls.rpy:213
translate indonesian radit_teddy_304e2670:

    # radit "Whoa, easy there..."
    radit  "Eits, hati-hati dong..."

# game/prologue_mpls.rpy:214
translate indonesian radit_teddy_16d229bd:

    # n "Your eyes glanced to your sides as you looked at that boy."
    n  "Matamu melirik ke samping dan menatap sosok pemuda yang barusan menyenggolmu."

# game/prologue_mpls.rpy:215
translate indonesian radit_teddy_fdf2bc39:

    # radit "Forgot to tie your shoes, pal?"
    radit  "Lupa ikat tali sepatu ya, sobat?"

# game/prologue_mpls.rpy:216
translate indonesian radit_teddy_83f604da:

    # p "Ah..."
    p  "Eh, iya..."

# game/prologue_mpls.rpy:227
translate indonesian radit_nice_838283a7:

    # radit "Mmm, I can see why. The ground's very down-to-earth."
    radit  "Hmm, pantesan aja. Emang tanah di sini ramah banget sampai mau dipeluk."

# game/prologue_mpls.rpy:228
translate indonesian radit_nice_ea30e7c3:

    # n "He said with a soft laugh that colored his tone."
    n  "Ucapnya diiringi tawa renyah yang memberi kehangatan pada nada bicaranya."

# game/prologue_mpls.rpy:229
translate indonesian radit_nice_e4d14c5f:

    # n "He appeared more approachable, a warmth radiating from his expression as he gradually moved closer."
    n  "Ia tampak begitu luwes dan ramah, aura hangat terpancar dari ekspresinya saat ia perlahan mendekat."

# game/prologue_mpls.rpy:230
translate indonesian radit_nice_902c1036:

    # radit "I'm Radit, nice to meet you...?"
    radit  "Kenalin, aku Radit. Salam kenal ya...?"

# game/prologue_mpls.rpy:231
translate indonesian radit_nice_a171c2d7:

    # n "He drew out the last syllable of his phrase, leaving a deliberate pause so you may introduce yourself."
    n  "Ia sengaja menggantung suku kata terakhirnya, memberi jeda agar kamu bisa memperkenalkan diri."

# game/prologue_mpls.rpy:232
translate indonesian radit_nice_4e274e41:

    # p "I'm [player_name]. Nice to meet you, too, Radit."
    p  "Aku [player_name]. Salam kenal juga, Radit."

# game/prologue_mpls.rpy:233
translate indonesian radit_nice_db6b8f05:

    # n "You intertwine your hand with his, creating a small, unexpected handshake."
    n  "Kamu menyambut uluran tangannya, saling berjabat tangan singkat yang tak terduga."

# game/prologue_mpls.rpy:235
translate indonesian radit_nice_c458efc7:

    # radit "So, are you joining the queue?"
    radit  "Jadi, kamu mau ikutan antre?"

# game/prologue_mpls.rpy:236
translate indonesian radit_nice_3f2d401b:

    # n "He raises one eyebrow, making you realise that the line is getting longer, and you haven't stepped in line."
    n  "Ia mengangkat sebelah alisnya, membuatmu sadar kalau antrean di stan makin panjang sementara kamu belum juga masuk barisan."

# game/prologue_mpls.rpy:237
translate indonesian radit_nice_ab1a3749:

    # p "You're right. I should hurry!"
    p  "Iya juga ya. Aku harus buru-buru antre nih!"

# game/prologue_mpls.rpy:238
translate indonesian radit_nice_d4d65d1c:

    # n "You were just about to step into line when you realised it would be rude to leave Radit alone."
    n  "Kamu baru saja hendak melangkah ke barisan saat tersadar kalau meninggalkan Radit begitu saja terasa kurang sopan."

# game/prologue_mpls.rpy:239
translate indonesian radit_nice_75416e60:

    # p "Don't you want to get some food too?"
    p  "Kamu nggak mau ikutan beli makan juga?"

# game/prologue_mpls.rpy:241
translate indonesian radit_nice_560e849e:

    # radit "I'm cool. Have fun though."
    radit  "Santai aja, aku udah kenyang kok. Selamat antre ya."

# game/prologue_mpls.rpy:243
translate indonesian radit_nice_34921d75:

    # n "He softly patted your shoulder before walking away. You kept your gaze on Radit as he departed."
    n  "Ia menepuk pelan pundakmu sebelum melangkah pergi. Pandanganmu terus mengikuti langkah Radit sampai ia menjauh."

# game/prologue_mpls.rpy:244
translate indonesian radit_nice_883fe37e:

    # n "You began to wonder if he was in the same major as you, but you quickly snapped back to reality."
    n  "Kamu sempat bertanya-tanya apakah ia satu jurusan denganmu, tapi kamu segera tersadar kembali ke kenyataan."

# game/prologue_mpls.rpy:245
translate indonesian radit_nice_cd64505f:

    # n "Some students had already returned—and you still hadn't placed your order."
    n  "Beberapa siswa sudah kembali membawa pesanan mereka—dan kamu sendiri bahkan belum sempat memesan apa-apa."

# game/prologue_mpls.rpy:252
translate indonesian radit_bad_728f7c42:

    # n "Wordlessly, you begin to turn your back on the calm boy and search for another food stall to retreat to."
    n  "Tanpa mengucap sepatah kata pun, kamu membalikkan badan meninggalkan pemuda tenang itu dan mencari stan lain untuk menepi."

# game/prologue_mpls.rpy:253
translate indonesian radit_bad_6b7d5821:

    # n "For a split second out of the corner of your eye, you notice the boy's playful expression subtly sour into a small frown."
    n  "Dari sudut matamu, sekilas kamu melihat senyum santai di wajahnya perlahan memudar menjadi kerutan kecil."

# game/prologue_mpls.rpy:255
translate indonesian radit_bad_5fff511d:

    # n "Despite having fled to the next stall, you could still feel the awkward air hanging around."
    n  "Meskipun sudah kabur ke stan sebelah, hawa canggung barusan masih terasa membekas di udara."

# game/prologue_mpls.rpy:263
translate indonesian chie_bathroom_84c0ead2:

    # n "You arise from your seat, following the crowd as it exits."
    n  "Kamu bangkit dari tempat dudukmu, mengikuti arus kerumunan yang melangkah keluar."

# game/prologue_mpls.rpy:264
translate indonesian chie_bathroom_50f54762:

    # n "The din of bustling crowds emphasizes your need to locate a restroom, urging you to get a move on."
    n  "Riuh suasana membuat keinginanmu mencari toilet terasa semakin mendesak, memaksamu untuk segera bergegas."

# game/prologue_mpls.rpy:265
translate indonesian chie_bathroom_9ae6af6c:

    # n "You pause, realising just how large the area of this school is."
    n  "Kamu berhenti sejenak, baru menyadari betapa luasnya area sekolah ini."

# game/prologue_mpls.rpy:266
translate indonesian chie_bathroom_e604b014:

    # n "Your eyes scan around, glancing to the right and left as you take in your surroundings."
    n  "Matamu memandang ke sekeliling, menoleh ke kanan dan ke kiri mengamati lingkungan sekitar."

# game/prologue_mpls.rpy:267
translate indonesian chie_bathroom_1c775f3c:

    # n "Before you can decide where to go, you feel a light tap on your shoulder, making you jolt slightly."
    n  "Sebelum sempat menentukan arah mana yang harus dituju, sebuah tepukan pelan mendarat di bahumu, membuatmu agak terlonjak kaget."

# game/prologue_mpls.rpy:268
translate indonesian chie_bathroom_10a6dc82:

    # n "Your eyes are caught by a glow of dandelion petals in various shades of amber hair."
    n  "Pandanganmu langsung tertuju pada helaian rambut bernuansa kuning keemasan yang cerah bagaikan kelopak bunga dandelion."

# game/prologue_mpls.rpy:269
translate indonesian chie_bathroom_78f6c6c8:

    # n "You freeze as a cheerful-looking girl stands in front of you."
    n  "Kamu terpaku saat melihat seorang gadis berwajah ceria berdiri tepat di hadapanmu."

# game/prologue_mpls.rpy:271
translate indonesian chie_bathroom_ed76d6ca:

    # chie "Hey! Are you lost?"
    chie  "Hai! Kamu nyasar ya?"

# game/prologue_mpls.rpy:282
translate indonesian chie_nice_7d07fbbb:

    # n "With an air of amusement, she wore a smile as her eyes followed the softness of her gesture."
    n  "Dengan raut geli nan jenaka, ia tersenyum ramah seraya menatapmu dengan gerak-gerik yang luwes."

# game/prologue_mpls.rpy:283
translate indonesian chie_nice_18fa483d:

    # chie "It's alright! Everyone has their first days, after all."
    chie  "Santai aja kali! Semua orang pasti ngalamin hal kayak gini di hari pertama."

# game/prologue_mpls.rpy:284
translate indonesian chie_nice_1deb8915:

    # n "She reaches for your hand, her grasp is gentle yet firm, conveying warmth and friendliness."
    n  "Ia meraih tanganmu, genggamannya lembut namun mantap, menyalurkan rasa hangat dan ramah."

# game/prologue_mpls.rpy:285
translate indonesian chie_nice_bd20a958:

    # chie "Here, I'll take you to the bathroom. I'm Chie, by the way!"
    chie  "Sini, kuantar ke toilet. Kenalin, namaku Chie ya!"

# game/prologue_mpls.rpy:286
translate indonesian chie_nice_fe24d8c2:

    # n "You barely had a chance to respond before the girl pulled you along with her. The energy Chie had was truly unstoppable."
    n  "Kamu hampir tak sempat menjawab saat gadis itu langsung menarikmu melangkah bersamanya. Energi Chie benar-benar tak terbendung."

# game/prologue_mpls.rpy:287
translate indonesian chie_nice_d55b645d:

    # n "You had just taken one step forward, and suddenly, both of you were standing in front of the toilet stalls."
    n  "Rasanya baru melangkah beberapa langkah, tiba-tiba kalian berdua sudah sampai tepat di depan deretan bilik toilet."

# game/prologue_mpls.rpy:289
translate indonesian chie_nice_26dcdea6:

    # chie "Here you go!"
    chie  "Tadaa! Udah sampai nih!"

# game/prologue_mpls.rpy:290
translate indonesian chie_nice_183bf5db:

    # n "She spread her arms in a grand motion; you could almost forget that she was leading you to a toilet."
    n  "Ia merentangkan kedua tangannya dengan gaya dramatis; kamu sampai hampir lupa kalau tempat yang ditunjukkannya ini cuma toilet."

# game/prologue_mpls.rpy:291
translate indonesian chie_nice_35bbe448:

    # chie "Yeah, it's not that amazing. But hey, it's better than the other toilets around here..."
    chie  "Yaah, emang nggak keren-keren amat sih. Tapi hei, toilet yang ini jauh lebih mending dibanding yang di sebelah sana..."

# game/prologue_mpls.rpy:293
translate indonesian chie_nice_79c57504:

    # chie "Let's just say the smell is... pungent."
    chie  "Anggap aja... yang di sana aromanya lumayan bikin merem melek."

# game/prologue_mpls.rpy:294
translate indonesian chie_nice_e9204224:

    # n "She glanced back at you with a playful smile on her lips. She let out a soft laugh, observing your stiff posture."
    n  "Ia menoleh ke arahmu dengan senyum usil di bibirnya. Tawa kecil meluncur saat memperhatikan postur tubuhmu yang masih kaku."

# game/prologue_mpls.rpy:295
translate indonesian chie_nice_1e66828f:

    # p "Thank you, uh... Chie."
    p  "Makasih banyak ya, eh... Chie."

# game/prologue_mpls.rpy:297
translate indonesian chie_nice_fe201b7a:

    # chie "No worries. Oh yeah, I didn't catch your name!"
    chie  "Sama-sama! Eh iya, tadi aku belum sempat nanya namamu!"

# game/prologue_mpls.rpy:298
translate indonesian chie_nice_11d635f0:

    # n "You paused. Chie was a very nice person."
    n  "Kamu terdiam sejenak. Chie ternyata orang yang sangat baik dan ramah."

# game/prologue_mpls.rpy:299
translate indonesian chie_nice_7f0c734a:

    # n "She might seem like a rabbit hopping around in her own words, but she is just another spirited individual."
    n  "Mungkin ia tampak lincah seperti kelinci yang melompat ke sana kemari, tapi ia hanyalah sosok gadis yang penuh semangat hidup."

# game/prologue_mpls.rpy:300
translate indonesian chie_nice_d278829a:

    # p "I'm [player_name]. Thanks again for your help, Chie."
    p  "Namaku [player_name]. Sekali lagi makasih banyak bantuannya ya, Chie."

# game/prologue_mpls.rpy:302
translate indonesian chie_nice_b8718ff9:

    # chie "Nice to meet you then, [player_name]!"
    chie  "Salam kenal kalau gitu, [player_name]!"

# game/prologue_mpls.rpy:303
translate indonesian chie_nice_14a122ec:

    # n "Suddenly, an announcement was faintly heard in your ears."
    n  "Tiba-tiba, suara pengumuman terdengar sayup-sayup menyapa telingamu."

# game/prologue_mpls.rpy:304
translate indonesian chie_nice_e8127879:

    # n "It must have been a sign that your break was ending. Chie lightly tapped your back."
    n  "Itu pasti tanda kalau waktu istirahat sebentar lagi berakhir. Chie menepuk ringan punggungmu."

# game/prologue_mpls.rpy:306
translate indonesian chie_nice_a11a5c98:

    # chie "I think it's also my time to head back. Good luck!"
    chie  "Kayaknya aku juga harus buru-buru balik nih. Semangat ya!"

# game/prologue_mpls.rpy:308
translate indonesian chie_nice_3c346b4e:

    # n "You waved at her as you watched her run and disappear around the corner."
    n  "Kamu melambaikan tangan ke arahnya seraya memperhatikan langkah riangnya yang berlari dan menghilang di balik tikungan."

# game/prologue_mpls.rpy:309
translate indonesian chie_nice_ccfa729b:

    # n "You smiled, hoping that you two would meet again."
    n  "Kamu tersenyum, berharap suatu saat nanti kalian berdua bisa bertemu lagi."

# game/prologue_mpls.rpy:315
translate indonesian chie_bad_0e752464:

    # n "You gave a brief, neutral reply and turned away."
    n  "Kamu hanya membalas singkat dan datar, lalu segera berbalik pergi."

# game/prologue_mpls.rpy:317
translate indonesian chie_bad_ed07c2a2:

    # chie "Oh."
    chie  "Oh..."

# game/prologue_mpls.rpy:319
translate indonesian chie_bad_40fb988a:

    # n "Her expression immediately dropped, revealing a hint of disappointment."
    n  "Ekspresi cerianya seketika lenyap, menyisakan gurat kekecewaan di wajahnya."

# game/prologue_mpls.rpy:320
translate indonesian chie_bad_2bd555e5:

    # n "She fiddled with her hands as she shifted her gaze from her fingers to your face."
    n  "Ia memainkan jemarinya seraya mengalihkan pandangannya dari jari ke arah wajahmu."

# game/prologue_mpls.rpy:321
translate indonesian chie_bad_f9b1f1ef:

    # chie "Ah, sorry 'bout that. I was just worried, you know."
    chie  "Ah, maaf ya kalau lancang. Aku cuma khawatir kamu bingung aja tadi."

# game/prologue_mpls.rpy:322
translate indonesian chie_bad_52a3f264:

    # n "An uncomfortable silence hung in the air."
    n  "Keheningan canggung yang menyesakkan menggantung di antara kalian berdua."

# game/prologue_mpls.rpy:323
translate indonesian chie_bad_92826e1f:

    # chie "Well, good luck, I guess?"
    chie  "Y-ya udah deh, semangat ya..."

# game/prologue_mpls.rpy:324
translate indonesian chie_bad_449a4fd4:

    # n "She plastered a strained smile on her face."
    n  "Ia memaksakan senyum tipis di bibirnya."

# game/prologue_mpls.rpy:325
translate indonesian chie_bad_990df9c1:

    # n "The corners of her mouth twitched as if fighting against a wave of emotions."
    n  "Sudut mulutnya berkedut sedikit, seolah berusaha keras menahan rasa tidak nyaman yang tiba-tiba datang."

# game/prologue_mpls.rpy:327
translate indonesian chie_bad_ddb5098e:

    # n "You responded with a simple nod, careful to keep your expression neutral, and turned away."
    n  "Kamu hanya membalas dengan anggukan pelan, sengaja menjaga ekspresimu tetap datar, lalu melangkah pergi."

# game/prologue_mpls.rpy:328
translate indonesian chie_bad_a7d3125e:

    # n "The significance of the moment seemed to cling to you, resembling a shadow."
    n  "Rasa canggung dari momen barusan terasa terus membayangi langkahmu bagaikan bayangan gelap."

# game/prologue_mpls.rpy:329
translate indonesian chie_bad_81c826ef:

    # n "An embarrassment so deep, it would resonate in your memory for all time."
    n  "Rasa malu yang begitu dalam, yang rasanya bakal terus membekas di ingatanmu untuk waktu yang lama."

# game/prologue_mpls.rpy:338
translate indonesian mpls_end_b85ca96c:

    # n "The rest of the MPLS Day passes in a blur of introductions, games, and the warm buzz of a school finding its rhythm."
    n  "Sisa hari MPLS berlalu cepat dalam balutan sesi perkenalan, games seru, dan hangatnya suasana sekolah yang mulai menemukan ritmenya."

# game/prologue_mpls.rpy:339
translate indonesian mpls_end_482ff9d8:

    # n "By the time you head home, the first seeds of this new chapter have been planted—and a new school year is only just beginning."
    n  "Saat langkah kakimu akhirnya membawamu pulang ke rumah, benih pertama dari babak baru ini telah tertanam—dan tahun ajaran baru baru saja dimulai."

translate indonesian strings:

